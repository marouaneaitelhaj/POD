          "mode": "id"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert Print-on-Demand creative director. Create a commercially strong but clearly original redesign concept based only on the high-level niche, audience, emotional hook, and theme. Never copy the original composition, wording, illustration, layout, brand, characters, trade dress, or distinctive visual elements. Change the illustration style, composition, typography, colors, perspective, and decorative elements. Return only valid JSON matching the schema."
            },
            {
              "content": "=Create one original redesign direction for this user-selected candidate.\n\nProduct idea: {{$json.productIdea}}\nOriginal title: {{$json.originalTitle}}\nOpportunity score: {{$json.opportunityScore}}\nVisible text: {{$json.visibleText}}\nReason: {{$json.reason}}\nSafer alternative: {{$json.saferAlternative}}\nAudience clues: infer from the product idea only.\n\nThe final image is intended for a print-on-demand shirt design. It should be centered, readable, print-ready, and isolated on a transparent background. Do not mention or recreate brands or protected characters."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"newConcept\": {\"type\": \"string\"},\n    \"newSlogan\": {\"type\": \"string\"},\n    \"targetAudience\": {\"type\": \"string\"},\n    \"illustrationStyle\": {\"type\": \"string\"},\n    \"composition\": {\"type\": \"string\"},\n    \"colorPalette\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n    \"typography\": {\"type\": \"string\"},\n    \"imagePrompt\": {\"type\": \"string\"},\n    \"negativePrompt\": {\"type\": \"string\"}\n  },\n  \"required\": [\"newConcept\",\"newSlogan\",\"targetAudience\",\"illustrationStyle\",\"composition\",\"colorPalette\",\"typography\",\"imagePrompt\",\"negativePrompt\"],\n  \"additionalProperties\": false\n}"
            }
          }
        }
      },
