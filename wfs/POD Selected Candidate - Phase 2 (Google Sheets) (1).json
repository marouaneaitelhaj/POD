    {
      "parameters": {
        "jsCode": "const response = $json;\nconst b64 = response?.data?.[0]?.b64_json;\nif (!b64) {\n  throw new Error('OpenAI did not return data[0].b64_json');\n}\nconst candidateId = $('Prepare Design Brief').item.json.candidateId;\nreturn [{\n  json: {\n    ...$('Prepare Design Brief').item.json,\n    imageCreated: true\n  },\n  binary: {\n    design: {\n      data: b64,\n      mimeType: 'image/png',\n      fileName: `pod-design-${candidateId}.png`,\n      fileExtension: 'png'\n    }\n  }\n}];"
      },
