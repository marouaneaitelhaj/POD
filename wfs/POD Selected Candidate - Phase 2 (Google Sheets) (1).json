      "parameters": {
        "jsCode": "const candidate = $('Keep One Selected Candidate').first().json;\n\nconst listing =\n  $('AI Listing Generator').first().json.output?.[0]?.content?.[0]?.text;\n\nif (!listing) {\n  throw new Error('Listing output is missing');\n}\n\nreturn [\n  {\n    json: {\n      success: true,\n      asin: candidate.ASIN,\n      designPath: `C:\\\\n8n\\\\generated\\\\${candidate.ASIN}-generated.png`,\n      designTitle: listing.designTitle,\n      brand: listing.brand,\n      featureBullet1: listing.featureBullet1,\n      featureBullet2: listing.featureBullet2,\n      productDescription: listing.productDescription\n    }\n  }\n];"
