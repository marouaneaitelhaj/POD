      "parameters": {
        "jsCode": "const requestedAsin = $('Validate ASIN').first().json.asin;\n\nconst candidate = $input.all().find(item => {\n  return String(item.json.ASIN ?? '').trim() === requestedAsin;\n});\n\nif (!candidate) {\n  throw new Error(`Candidate not found for ASIN: ${requestedAsin}`);\n}\n\nreturn [candidate];"
      },
      "type": "n8n-nodes-base.code",
