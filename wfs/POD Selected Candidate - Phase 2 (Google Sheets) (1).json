        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an Amazon Merch listing specialist.\n\nCreate a clear, readable, keyword-aware listing for a print-on-demand apparel design.\n\nRules:\n- Do not use trademarked brands, celebrity names, movie titles, game titles, song lyrics, or copyrighted characters.\n- Do not copy the source product listing.\n- Keep the wording natural and commercially useful.\n- Avoid keyword stuffing.\n- Match the generated design concept and target audience.\n- Respect the character limits exactly.\n- Return only valid JSON matching the required schema.\n\nCharacter limits:\n- designTitle: 3 to 60 characters\n- brand: 3 to 50 characters\n- featureBullet1: maximum 256 characters\n- featureBullet2: maximum 256 characters\n- productDescription: 75 to 2000 characters"
            },
            {
              "content": "=Create an Amazon Merch listing for this generated design.\n\nOriginal candidate:\nProduct idea: {{ $('Keep One Selected Candidate').item.json[\"Product Idea\"] }}\nOriginal title: {{ $('Keep One Selected Candidate').item.json.Title }}\nCategory: {{ $('Keep One Selected Candidate').item.json.Category }}\nSafer alternative: {{ $('Keep One Selected Candidate').item.json[\"Safer Alternative\"] }}\n\nGenerated design brief:\nNew concept: {{ $('AI ReDesign Prompt').item.json.output[0].content[0].text.newConcept }}\nNew slogan: {{ $('AI ReDesign Prompt').item.json.output[0].content[0].text.newSlogan }}\nTarget audience: {{ $('AI ReDesign Prompt').item.json.output[0].content[0].text.targetAudience }}\nIllustration style: {{ $('AI ReDesign Prompt').item.json.output[0].content[0].text.illustrationStyle }}\nComposition: {{ $('AI ReDesign Prompt').item.json.output[0].content[0].text.composition }}\n\nGenerate:\n1. A concise design title.\n2. A safe, original brand name.\n3. Feature bullet 1 focused on the concept and audience.\n4. Feature bullet 2 focused on gifting occasions and wearer interests.\n5. A natural product description of at least 75 characters.\n\nDo not include:\n- labels such as \"Title:\"\n- markdown\n- explanations\n- extra fields"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"designTitle\": {\n      \"type\": \"string\",\n      \"minLength\": 3,\n      \"maxLength\": 60\n    },\n    \"brand\": {\n      \"type\": \"string\",\n      \"minLength\": 3,\n      \"maxLength\": 50\n    },\n    \"featureBullet1\": {\n      \"type\": \"string\",\n      \"maxLength\": 256\n    },\n    \"featureBullet2\": {\n      \"type\": \"string\",\n      \"maxLength\": 256\n    },\n    \"productDescription\": {\n      \"type\": \"string\",\n      \"minLength\": 75,\n      \"maxLength\": 2000\n    }\n  },\n  \"required\": [\n    \"designTitle\",\n    \"brand\",\n    \"featureBullet1\",\n    \"featureBullet2\",\n    \"productDescription\"\n  ],\n  \"additionalProperties\": false\n}"
            }
          }
        }
