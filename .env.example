# Base URL used by the frontend to reach n8n.
# Local dev (recommended): use the Vite proxy defined in vite.config.ts.
# The proxy forwards /n8n-api/* -> http://localhost:5678/*
VITE_N8N_BASE_URL=/n8n-api

# If you prefer to call n8n directly instead of using the proxy,
# set VITE_N8N_BASE_URL=http://localhost:5678 and enable CORS in n8n
# (see README.md "CORS" section).

VITE_ANALYZE_WEBHOOK_PATH=/webhook/pod/analyze
VITE_GENERATE_WEBHOOK_PATH=/webhook/pod/generate
